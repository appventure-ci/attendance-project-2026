# Public address students reach the site at. No trailing slash.
# Must match the redirect URI registered in Azure AD (Entra ID).
PUBLIC_URL=https://attendance.example.com

# Azure AD (Entra ID) app registration
MS_CLIENT_ID=your-application-client-id
MS_CLIENT_SECRET=paste-the-secret-value-here
# Your school's Directory (tenant) ID from the app's Overview page.
# Use "organizations" only if the app is registered as multi-tenant.
MS_TENANT=your-tenant-id

# Only accept this email domain (leave blank to allow any work/school account)
ALLOWED_DOMAIN=myschool.edu.sg
# Comma-separated school emails that can open /master and /admin
ADMIN_EMAILS=you@myschool.edu.sg

# Signs sessions and generates the rotating codes. Keep private.
MASTER_SECRET=generate-with-openssl-rand-hex-32

TZ_NAME=Asia/Singapore
# Number of reverse proxies in front of the app (Caddy, nginx, Cloudflare tunnel = 1).
TRUST_PROXY=1
